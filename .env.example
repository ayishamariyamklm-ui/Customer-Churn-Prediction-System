# ===============================
# APPLICATION SETTINGS
# ===============================
APP_ENV=development
DEBUG=True
APP_HOST=127.0.0.1
APP_PORT=5000

# ===============================
# PATH CONFIGURATIONS
# ===============================
DATA_PATH=data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv
MODEL_PATH=models/churn_model.pkl
METRICS_PATH=models/metrics.json

# ===============================
# LOGGING
# ===============================
LOG_FILE=logs/app.log
LOG_LEVEL=INFO

# ===============================
# MODEL CONFIGURATION
# ===============================
MODEL_TYPE=RandomForest
N_ESTIMATORS=150
MAX_DEPTH=8
RANDOM_STATE=42
TEST_SIZE=0.2

# ===============================
# API SETTINGS
# ===============================
API_HOST=0.0.0.0
API_PORT=8000
